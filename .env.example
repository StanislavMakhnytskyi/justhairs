# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps Embed API key (optional). When unset, the Home page shows an
# address + "Open in Google Maps" link instead of an embedded map.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Set to "true" once an SMS provider (Twilio/MessageBird) is configured in Supabase Auth.
# Until then the phone-OTP sign-in option shows a "not configured" notice.
NEXT_PUBLIC_SMS_ENABLED=false
