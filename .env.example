# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode) — optional; without it the pay page only offers "pay later"
STRIPE_SECRET_KEY=

# App � REQUIRED in production (Stripe return URLs are built from it; checkout
# refuses to start without it rather than trusting the Host header)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Regression tests (Playwright, see docs/development.md "Regression testing") — not read
# by the Next app itself, only by playwright.config.ts.
TEST_PROD_URL=https://justhairs.vercel.app
TEST_PREVIEW_URL=

# Home hero
# Set to 1 to play the hero background video (hero-<HERO_VERSION>.mp4/.webm in the
# Storage "assets" bucket, see scripts/prepare-hero.mjs). Without it the hero shows
# only the poster frame.
NEXT_PUBLIC_HERO_VIDEO=

# Stripe webhook (/api/stripe/webhook) — signing secret of the endpoint you register
# in the Stripe dashboard (or `stripe listen` prints one locally). Without it the
# route answers 503 and payments are only recorded when the guest returns to the
# confirmation page.
STRIPE_WEBHOOK_SECRET=
