{
  "name": "justhairs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:smoke": "playwright test tests/smoke",
    "test:smoke:preview": "cross-env PW_TARGET=preview playwright test tests/smoke",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:preview": "cross-env PW_TARGET=preview playwright test tests/e2e",
    "playwright:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "shots": "node scripts/shots.mjs",
    "check:flow": "node scripts/flow-check.mjs",
    "db:setup": "node scripts/build-setup-sql.mjs",
    "db:setup:check": "node scripts/build-setup-sql.mjs --check",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:db": "node --test \"tests/db/*.test.mjs\"",
    "types:gen": "supabase gen types typescript --project-id vyrgrzmsslcaztkydlng --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/leaflet": "^1.9.22",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
